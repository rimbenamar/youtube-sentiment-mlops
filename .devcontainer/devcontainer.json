{
  "name": "Écho - API de sentiment YouTube",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "API sentiment", "onAutoForward": "silent" }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "postStartCommand": "nohup bash scripts/start_api.sh > /tmp/start_api.log 2>&1 &",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"] }
  }
}
